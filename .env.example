PORT=8080
LOG_LEVEL=info

# WhatsApp Web JS
WWEBJS_CLIENT_ID=default
PUPPETEER_HEADLESS=true
DATA_DIR=/data

# DB (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wappdb
DB_USER=wapp
DB_PASSWORD=wapp

# Webhook signing secret (optional if you want signatures). If empty, no signature header is sent.
WEBHOOK_SECRET=change-me
